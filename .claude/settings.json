{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/tools/check_codebase_memory.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Comprobando codebase-memory..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/tools/hook_node_fork_warning.py\"",
            "timeout": 15,
            "statusMessage": "Comprobando la copia bifurcada del nodo"
          }
        ]
      }
    ]
  }
}
